# 跨平台行尾统一：默认所有文本文件 LF，覆盖 .yaml/.xml/.urdf/.cpp/.msg/.rviz/.md 等
# 避免 core.autocrlf 在工作区产生 CRLF 后经 rsync push 泄漏到 RDK（破坏 bash/解析）

* text=auto eol=lf

# Shell 脚本必须 LF（CRLF 会导致 /bin/bash: bad interpreter）
*.sh     text eol=lf
*.bash   text eol=lf

# Python 统一 LF
*.py     text eol=lf

# Windows 专用脚本保留 CRLF
*.ps1    text eol=crlf
*.bat    text eol=crlf
*.cmd    text eol=crlf

# 二进制文件不转换
*.STL    binary
*.stl    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.bag    binary
*.pdf    binary
*.ico    binary
*.dds    binary
*.deb    binary
