<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>smartcar_vision</name>
  <version>0.1.0</version>
  <description>QR recognition and bounded local VLM services for SmartCar.</description>
  <maintainer email="lx_hmkk@qq.com">LX-HMKK</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>smartcar_interfaces</exec_depend>
  <exec_depend>zbar_ros</exec_depend>
  <exec_depend>deptrum-ros-driver-aurora930</exec_depend>
  <exec_depend>hobot_usb_cam</exec_depend>
  <exec_depend>mipi_cam</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
