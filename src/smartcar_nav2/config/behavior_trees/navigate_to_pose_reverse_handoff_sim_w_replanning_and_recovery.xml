<!-- Gazebo-only reverse handoff. The permitted short retreat also sweeps the
     simulated KeepoutFilter mask before FollowPath can receive a goal. -->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <OdomDistanceBudget
        goal="{goal}"
        odom_topic="/odom_combined"
        odom_frame="odom_combined"
        robot_base_frame="base_footprint"
        max_distance_ratio="2.00"
        distance_slack_m="0.80"
        max_odom_step_m="0.50"
        odom_timeout_sec="0.50"
        initial_odom_wait_sec="1.00">
      <Sequence name="NavigateReverseHandoffWithSingleRetreat">
      <LatchSuccess name="InitializeReverseHandoffRetreatGate">
        <SetBlackboard value="false" output_key="reverse_retreat_used"/>
      </LatchSuccess>
    <RecoveryNode number_of_retries="6" name="NavigateReverseHandoffRecovery">
      <Sequence name="NavigateReverseHandoffWithFailureReplanning">
        <LatchSuccess name="LatchValidatedReverseHandoffPath">
          <RecoveryNode number_of_retries="1" name="ComputeValidatedReverseHandoffPath">
            <Sequence>
              <ComputeReverseFreeHeadingPathToPose
                goal="{goal}"
                path="{path}"
                recovery_eligible="{reverse_handoff_recovery_eligible}"
                costmap_stamp_ns="{reverse_handoff_planner_costmap_stamp_ns}"
                local_costmap_stamp_ns="{reverse_handoff_planner_local_costmap_stamp_ns}"
                planner_id="GridBased"
                heading_samples="12"
                candidate_timeout_ms="3500"
                search_budget_ms="2400"
                max_start_drift_m="0.10"
                footprint_half_length_m="0.2491"
                footprint_half_width_m="0.095"
                footprint_sweep_step_m="0.025"
                footprint_lethal_cost="254"
                curvature_tolerance="0.20"
                maximum_direction_error="0.35"
                start_position_tolerance="0.10"
                start_yaw_tolerance="0.15"
                goal_position_tolerance="0.12"
                goal_yaw_tolerance="0.15"
                minimum_segment_length="0.0001"/>
              <IsPathValid path="{path}" server_timeout="100"/>
            </Sequence>
            <Sequence name="ClearReverseHandoffCostmapsBeforeRetreat">
              <ClearEntireCostmap
                name="ClearLocalCostmap-ReverseHandoffContext"
                service_name="local_costmap/clear_entirely_local_costmap"/>
              <ClearEntireCostmap
                name="ClearGlobalCostmap-ReverseHandoffContext"
                service_name="global_costmap/clear_entirely_global_costmap"/>
            </Sequence>
          </RecoveryNode>
        </LatchSuccess>
        <RecordFollowPath
          path="{path}"
          controller_id="ReverseHandoff"
          goal_checker_id="reverse_goal_checker"/>
      </Sequence>
      <Fallback name="RecoverReverseHandoffTerminalPoseOrClear">
        <Sequence name="ReverseHandoffRetreatBeforeReplan">
          <ReverseRecoveryEligible
            eligible="{reverse_handoff_recovery_eligible}"/>
          <ClearEntireCostmap
            name="ClearLocalCostmap-BeforeReverseHandoffRetreat"
            service_name="local_costmap/clear_entirely_local_costmap"/>
          <ClearEntireCostmap
            name="ClearGlobalCostmap-BeforeReverseHandoffRetreat"
            service_name="global_costmap/clear_entirely_global_costmap"/>
          <AckermannReverseRetreat
            allow_retreat="{reverse_handoff_recovery_eligible}"
            retreat_used="{reverse_retreat_used}"
            path="{reverse_retreat_path}"
            controller_id="FollowPath"
            goal_checker_id="recovery_goal_checker"
            retreat_distance_m="0.15"
            retreat_direction="forward"
            costmap_max_age_ms="1500"
            perception_wait_timeout_ms="2600"
            follow_path_goal_timeout_ms="1000"
            follow_path_result_timeout_ms="12000"
            scan_costmap_fusion_lag_ms="1250"
            static_keepout_mask_topic="/keepout_filter_mask"
            allow_static_scan_only_evidence="true"
            costmap_min_stamp_ns="{reverse_handoff_planner_costmap_stamp_ns}"
            local_costmap_min_stamp_ns="{reverse_handoff_planner_local_costmap_stamp_ns}"
            footprint_half_length_m="0.2491"
            footprint_half_width_m="0.095"
            footprint_sweep_step_m="0.025"
            footprint_lethal_cost="253"
            scan_min_obstacle_range_m="0.25"
            scan_max_obstacle_range_m="2.50"
            scan_costmap_match_radius_m="0.12"
            retreat_odom_max_age_ms="500"
            retreat_odom_max_step_m="0.05"
            retreat_odom_max_travel_m="0.19"
            retreat_odom_max_displacement_m="0.19"/>
          <ClearEntireCostmap
            name="ClearLocalCostmap-AfterReverseHandoffRetreat"
            service_name="local_costmap/clear_entirely_local_costmap"/>
          <ClearEntireCostmap
            name="ClearGlobalCostmap-AfterReverseHandoffRetreat"
            service_name="global_costmap/clear_entirely_global_costmap"/>
        </Sequence>
        <Sequence name="ClearReverseHandoffCostmapsRecovery">
          <Inverter>
            <ReverseRecoveryEligible
              eligible="{reverse_handoff_recovery_eligible}"/>
          </Inverter>
          <ClearEntireCostmap
            name="ClearLocalCostmap-ReverseHandoffSubtree"
            service_name="local_costmap/clear_entirely_local_costmap"/>
          <ClearEntireCostmap
            name="ClearGlobalCostmap-ReverseHandoffSubtree"
            service_name="global_costmap/clear_entirely_global_costmap"/>
        </Sequence>
      </Fallback>
    </RecoveryNode>
      </Sequence>
    </OdomDistanceBudget>
  </BehaviorTree>
</root>
