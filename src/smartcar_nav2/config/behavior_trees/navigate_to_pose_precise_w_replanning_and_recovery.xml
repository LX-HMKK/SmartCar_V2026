<!-- Precise forward handoff tree: no backup, wait, spin, or in-place rotation. -->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <!-- The P-to-A geometry has a direct 1.00x feasible Dubins path. Limit
         measured travel to one modest avoidance arc; a controller that starts
         orbiting must fail/replan instead of completing a large circle. -->
    <OdomDistanceBudget
        goal="{goal}"
        odom_topic="/odom_combined"
        odom_frame="odom_combined"
        robot_base_frame="base_footprint"
        max_distance_ratio="1.40"
        distance_slack_m="0.40"
        max_odom_step_m="0.50"
        odom_timeout_sec="0.50"
        initial_odom_wait_sec="1.00">
      <!-- One clear/replan retry is enough for a transient scan; more retries
           create repeated Ackermann arcs and can turn a local failure into a
           large loop. -->
      <RecoveryNode number_of_retries="1" name="NavigatePreciseRecovery">
        <PipelineSequence name="NavigatePreciseWithReplanning">
          <LatchSuccess name="LatchPreciseFreeHeadingPathToPose">
            <RateController hz="0.5">
              <RecoveryNode number_of_retries="1" name="ComputePreciseFreeHeadingPathToPose">
                <!-- The shared real-car tree must never inject the P-only
                     Gazebo departure connector. The simulator uses a copied
                     tree with this opt-in enabled after its own wiring. -->
                <ComputeFreeHeadingPathToPose
                    goal="{goal}"
                    path="{path}"
                    planner_id="GridBased"
                    heading_samples="12"
                    candidate_timeout_ms="3500"
                    max_start_drift_m="0.10"
                    footprint_half_length_m="0.2491"
                    footprint_half_width_m="0.095"
                    footprint_sweep_step_m="0.025"
                    footprint_lethal_cost="254"
                    local_tracking_cross_track_error_m="0.10"
                    local_tracking_horizon_m="0.50"
                    local_tracking_lethal_cost="254"
                    maximum_direction_error="0.15"
                    departure_connector_enabled="false"
                    departure_connector_radius_margin_m="0.28"
                    departure_connector_maximum_active_radius_m="0.50"
                    departure_connector_terminal_radius_m="0.22"
                    departure_connector_start_x_m="0.0"
                    departure_connector_start_y_m="0.0"
                    departure_connector_start_yaw_rad="0.0"
                    departure_connector_start_position_tolerance_m="0.10"
                    departure_connector_start_yaw_tolerance_rad="0.15"
                    departure_connector_heading_bins="144"/>
                <ClearEntireCostmap name="ClearGlobalCostmap-PreciseContext" service_name="global_costmap/clear_entirely_global_costmap"/>
              </RecoveryNode>
            </RateController>
          </LatchSuccess>
          <RecoveryNode number_of_retries="1" name="FollowPrecisePath">
            <!-- The P-to-A connector has tight, changing curvature and a
                 locked terminal heading.  Use the forward-only Ackermann
                 MPPI wrapper here; it preserves footprint cost checks while
                 tracking the body-swept connector without RPP's early-carrot
                 steering bias. -->
            <RecordFollowPath path="{path}" controller_id="ForwardHandoff" goal_checker_id="precise_goal_checker"/>
            <ClearEntireCostmap name="ClearLocalCostmap-PreciseContext" service_name="local_costmap/clear_entirely_local_costmap"/>
          </RecoveryNode>
        </PipelineSequence>
        <Sequence name="ClearPreciseCostmapsRecovery">
          <ClearEntireCostmap name="ClearLocalCostmap-PreciseSubtree" service_name="local_costmap/clear_entirely_local_costmap"/>
          <ClearEntireCostmap name="ClearGlobalCostmap-PreciseSubtree" service_name="global_costmap/clear_entirely_global_costmap"/>
        </Sequence>
      </RecoveryNode>
    </OdomDistanceBudget>
  </BehaviorTree>
</root>
