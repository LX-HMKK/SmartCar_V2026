<?xml version="1.0" ?>
<sdf version="1.8">
<world name="smartcar_track">
  <!-- Physics: 200Hz step (0.005s), sufficient for 0.15 m/s Ackermann navigation.
       type="dart" is Gazebo Fortress default; 5ms vs 1ms saves ~40% CPU. -->
  <physics name="5ms" type="dart">
    <max_step_size>0.005</max_step_size>
    <real_time_factor>1.0</real_time_factor>
  </physics>

  <!-- GUI plugin -->
  <plugin
    filename="ignition-gazebo-gui-system"
    name="ignition::gazebo::systems::Gui">
  </plugin>

  <!-- User commands -->
  <plugin
    filename="ignition-gazebo-user-commands-system"
    name="ignition::gazebo::systems::UserCommands">
  </plugin>

  <!-- Physics -->
  <plugin
    filename="ignition-gazebo-physics-system"
    name="ignition::gazebo::systems::Physics">
  </plugin>

  <!-- Sensors (LiDAR + IMU) -->
  <plugin
    filename="ignition-gazebo-sensors-system"
    name="ignition::gazebo::systems::Sensors">
    <render_engine>ogre</render_engine>
  </plugin>

  <!-- Scene broadcaster -->
  <plugin
    filename="ignition-gazebo-scene-broadcaster-system"
    name="ignition::gazebo::systems::SceneBroadcaster">
  </plugin>

  <!-- ===== LIGHTING ===== -->
  <light type="directional" name="sun">
    <pose>5 5 10 0 0 0</pose>
    <diffuse>1 1 1 1</diffuse>
    <specular>0.5 0.5 0.5 1</specular>
    <attenuation>
      <range>50</range>
    </attenuation>
    <direction>-0.5 -0.5 -1.0</direction>
    <cast_shadows>true</cast_shadows>
  </light>

  <!-- ===== GROUND PLANE ===== -->
  <model name="ground_plane">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>20 20</size>
          </plane>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.8</mu><mu2>0.8</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>20 20</size>
          </plane>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.4 0.4 0.4 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <!-- Generated from smartcar_tools/config/routes/field_geometry.yaml.
       Collision policy lives in config/competition_field_model.yaml. -->
  <include>
    <uri>model://competition_field</uri>
  </include>

  <!-- ===== ZONE-A CONE OBSTACLES (0.3×0.3m cubes, randomly placeable) =====
    A 区随机锥桶群。调参时修改 <pose> 调整位置，或注释掉部分锥桶测试不同密度。
  -->
  <model name="cone_a1"><static>true</static><pose>0.8 0.4 0.15 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>0.3 0.3 0.3</size></box></geometry>
      <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>0.3 0.3 0.3</size></box></geometry></collision>
    </link></model>
  <model name="cone_a2"><static>true</static><pose>1.5 0.3 0.15 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>0.3 0.3 0.3</size></box></geometry>
      <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>0.3 0.3 0.3</size></box></geometry></collision>
    </link></model>
  <model name="cone_a3"><static>true</static><pose>2.2 0.5 0.15 0 0 0.3</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>0.3 0.3 0.3</size></box></geometry>
      <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>0.3 0.3 0.3</size></box></geometry></collision>
    </link></model>
  <model name="cone_a4"><static>true</static><pose>1.0 0.8 0.15 0 0 0.5</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>0.3 0.3 0.3</size></box></geometry>
      <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>0.3 0.3 0.3</size></box></geometry></collision>
    </link></model>
  <model name="cone_a5"><static>true</static><pose>1.8 0.9 0.15 0 0 -0.3</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>0.3 0.3 0.3</size></box></geometry>
      <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>0.3 0.3 0.3</size></box></geometry></collision>
    </link></model>
  <model name="cone_a6"><static>true</static><pose>2.8 0.7 0.15 0 0 0.7</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>0.3 0.3 0.3</size></box></geometry>
      <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>0.3 0.3 0.3</size></box></geometry></collision>
    </link></model>

  <!-- ===== B-ZONE WALLS =====
    B-zone is a 0.5m transverse band at y∈[2.0,2.5]. The 1.0m corridor
    opening sits at x∈[2.0,3.0] (center x=2.5m from west). Two static
    walls block the non-corridor portions so LiDAR scans propagate into
    the costmap and Smac Hybrid planner naturally routes through the gap.
    Walls are 0.3m tall — high enough for 2D LiDAR detection, low enough
    not to introduce spurious 3D occlusion in Gazebo visualisation.
  -->
  <model name="b_zone_wall_left"><static>true</static><pose>1.0 2.25 0.15 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>2.0 0.5 0.5</size></box></geometry>
      <material><ambient>0.6 0.6 0.2 1</ambient><diffuse>0.6 0.6 0.2 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>2.0 0.5 0.5</size></box></geometry></collision>
    </link></model>
  <model name="b_zone_wall_right"><static>true</static><pose>4.0 2.25 0.15 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>2.0 0.5 0.5</size></box></geometry>
      <material><ambient>0.6 0.6 0.2 1</ambient><diffuse>0.6 0.6 0.2 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>2.0 0.5 0.5</size></box></geometry></collision>
    </link></model>

  <!-- ===== C-ZONE RING WALLS =====
    C-zone ring: outer 4.0×1.65m centre (2.5,3.575) → y∈[2.75,4.40],
    inner hole 3.0×0.65m centre (2.5,3.575) → y∈[3.25,3.90].
    Four walls constrain the planner to the ring-shaped track:
      inner fill — blocks the centre (forces vehicles to go around)
      north / left / right — block the field boundaries beyond the ring
    The bottom of the ring is open toward B-zone corridor for entry/exit.
  -->
  <model name="c_zone_inner"><static>true</static><pose>2.5 3.575 0.15 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>3.0 0.65 0.5</size></box></geometry>
      <material><ambient>0.2 0.6 0.6 1</ambient><diffuse>0.2 0.6 0.6 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>3.0 0.65 0.5</size></box></geometry></collision>
    </link></model>
  <model name="c_zone_north"><static>true</static><pose>2.5 4.7 0.15 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>5.0 0.6 0.5</size></box></geometry>
      <material><ambient>0.2 0.6 0.6 1</ambient><diffuse>0.2 0.6 0.6 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>5.0 0.6 0.5</size></box></geometry></collision>
    </link></model>
  <model name="c_zone_west"><static>true</static><pose>0.25 3.575 0.15 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>0.5 1.65 0.5</size></box></geometry>
      <material><ambient>0.2 0.6 0.6 1</ambient><diffuse>0.2 0.6 0.6 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>0.5 1.65 0.5</size></box></geometry></collision>
    </link></model>
  <model name="c_zone_east"><static>true</static><pose>4.75 3.575 0.15 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>0.5 1.65 0.5</size></box></geometry>
      <material><ambient>0.2 0.6 0.6 1</ambient><diffuse>0.2 0.6 0.6 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>0.5 1.65 0.5</size></box></geometry></collision>
    </link></model>

  <!-- ===== ROBOT ===== -->
  <include>
    <pose>0 0 0.03 0 0 0</pose>
    <uri>model://origincar</uri>
  </include>

</world>
</sdf>
