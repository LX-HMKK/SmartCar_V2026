<?xml version="1.0" encoding="UTF-8"?>
<!-- FastDDS 纯共享内存传输配置
     绕过 WSL2 网络层 DDS discovery 阻断问题。
     所有 ROS2 进程通过 /dev/shm 通信（discovery + user data），不经过 UDP/TCP。
     仅适用于所有节点在同一台机器上的场景（如 WSL2 仿真）。
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>ShmTransport</transport_id>
      <type>SHM</type>
      <segment_size>10485760</segment_size>
      <port_queue_capacity>4096</port_queue_capacity>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="shm_participant" is_default_profile="true">
    <rtps>
      <!-- 用户数据走 SHM -->
      <userTransports>
        <transport_id>ShmTransport</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
      <!-- 内置发现协议也走 SHM -->
      <builtin>
        <metatrafficUnicastLocatorList>
          <locator><kind>SHM</kind></locator>
        </metatrafficUnicastLocatorList>
        <initialPeersList>
          <locator><kind>SHM</kind></locator>
        </initialPeersList>
      </builtin>
    </rtps>
  </participant>
</profiles>
