<?xml version="1.0" ?>
<sdf version="1.8">
<model name="origincar">
  <!-- OriginCar Ackermann robot for Gazebo Fortress
       Dimensions: wheelbase=0.144m, track=0.162m, wheel_r=0.03m
       Rear-axle origin (base_footprint) -->

  <!-- ===== BASE FOOTPRINT (rear axle, origin) ===== -->
  <link name="base_footprint">
    <!-- This is a coordinate frame, not a kilogram of chassis mass. SDF
         assigns an omitted inertial a 1 kg default, which shifts the model's
         centre of mass down to the rear axle and distorts steering dynamics. -->
    <inertial>
      <mass>0.001</mass>
      <inertia><ixx>0.000001</ixx><iyy>0.000001</iyy><izz>0.000001</izz></inertia>
    </inertial>
  </link>

  <!-- ===== BASE LINK (chassis center, 0.0841m forward of rear axle) ===== -->
  <link name="base_link">
    <pose>0.0841 0 0.03 0 0 0</pose>
    <inertial>
      <mass>2.5</mass>
      <inertia>
        <ixx>0.05</ixx><iyy>0.08</iyy><izz>0.08</izz>
      </inertia>
    </inertial>
    <visual name="body_visual">
      <!-- Keep the calibrated base_link frame at wheel-centre height and
           lift only the chassis geometry to retain ground clearance. -->
      <pose>0 0 0.03 0 0 0</pose>
      <geometry><box><size>0.276 0.164 0.08</size></box></geometry>
      <material>
        <ambient>0.2 0.2 0.8 1</ambient>
        <diffuse>0.2 0.2 0.8 1</diffuse>
      </material>
    </visual>
    <collision name="body_collision">
      <pose>0 0 0.03 0 0 0</pose>
      <geometry><box><size>0.276 0.164 0.06</size></box></geometry>
    </collision>

    <sensor name="imu_sensor" type="imu">
      <topic>/imu</topic>
      <update_rate>20</update_rate>  <!-- sim: EKF bypassed, IMU unused, 100→20 saves CPU -->
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.0003</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.0003</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.0003</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </link>

  <!-- ===== LASER LINK ===== -->
  <link name="laser_link">
    <!-- Preserve base_link -> laser_link = (-0.05, 0, 0.23). -->
    <pose>0.0341 0 0.26 0 0 0</pose>
    <inertial>
      <mass>0.001</mass>
      <inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia>
    </inertial>
    <visual name="laser_visual">
      <geometry><cylinder><radius>0.02</radius><length>0.04</length></cylinder></geometry>
      <material><ambient>0.5 0.5 0.5 1</ambient></material>
    </visual>
    <!--
      Fortress 6.18 only supports GPU lidar.  The server-only launcher enables
      headless rendering, so this sensor receives an off-screen Ogre2 scene in
      both automated and GUI runs.  Starting the server without that rendering
      context makes every beam collapse to the minimum range, which Nav2
      correctly filters as self-observation.
    -->
    <sensor name="lidar_sensor" type="gpu_lidar">
      <topic>/scan</topic>
      <update_rate>20</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range><min>0.1</min><max>12.0</max><resolution>0.01</resolution></range>
      </lidar>
      <always_on>true</always_on>
      <visualize>0</visualize>
    </sensor>
  </link>

  <!-- ===== STEERING KNUCKLES (invisible) ===== -->
  <link name="up_left_steer_link">
    <pose>0.144 0.081 0.03 0 0 0</pose>
    <inertial>
      <mass>0.001</mass>
      <inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia>
    </inertial>
  </link>

  <link name="up_right_steer_link">
    <pose>0.144 -0.081 0.03 0 0 0</pose>
    <inertial>
      <mass>0.001</mass>
      <inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia>
    </inertial>
  </link>

  <!-- ===== WHEELS ===== -->
  <!-- Rear-left -->
  <link name="down_left_Link">
    <pose>0 0.081 0.03 0 0 0</pose>
    <inertial>
      <mass>0.05</mass>
      <inertia><ixx>0.0001</ixx><iyy>0.00005</iyy><izz>0.0001</izz></inertia>
    </inertial>
    <visual name="down_left_visual">
      <!-- SDF cylinders are Z-axis by default; a wheel rolling about the
           Y-axis must be rotated into that joint frame. -->
      <pose>0 0 0 1.5707963267948966 0 0</pose>
      <geometry><cylinder><radius>0.03</radius><length>0.025</length></cylinder></geometry>
      <material><ambient>0.1 0.1 0.1 1</ambient></material>
    </visual>
    <collision name="down_left_collision">
      <pose>0 0 0 1.5707963267948966 0 0</pose>
      <geometry><cylinder><radius>0.03</radius><length>0.025</length></cylinder></geometry>
      <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
    </collision>
  </link>

  <!-- Rear-right -->
  <link name="down_right_Link">
    <pose>0 -0.081 0.03 0 0 0</pose>
    <inertial>
      <mass>0.05</mass>
      <inertia><ixx>0.0001</ixx><iyy>0.00005</iyy><izz>0.0001</izz></inertia>
    </inertial>
    <visual name="down_right_visual">
      <pose>0 0 0 1.5707963267948966 0 0</pose>
      <geometry><cylinder><radius>0.03</radius><length>0.025</length></cylinder></geometry>
      <material><ambient>0.1 0.1 0.1 1</ambient></material>
    </visual>
    <collision name="down_right_collision">
      <pose>0 0 0 1.5707963267948966 0 0</pose>
      <geometry><cylinder><radius>0.03</radius><length>0.025</length></cylinder></geometry>
      <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
    </collision>
  </link>

  <!-- Front-left wheel -->
  <link name="up_left_Link">
    <!-- Keep the rolling link coincident with its steering knuckle. A zero
         model-frame pose pins this front tyre at the rear-axle origin after
         physics starts, which creates a false three-wheel contact model. -->
    <pose>0.144 0.081 0.03 0 0 0</pose>
    <inertial>
      <mass>0.05</mass>
      <inertia><ixx>0.0001</ixx><iyy>0.00005</iyy><izz>0.0001</izz></inertia>
    </inertial>
    <visual name="up_left_visual">
      <pose>0 0 0 1.5707963267948966 0 0</pose>
      <geometry><cylinder><radius>0.03</radius><length>0.025</length></cylinder></geometry>
      <material><ambient>0.1 0.1 0.1 1</ambient></material>
    </visual>
    <collision name="up_left_collision">
      <pose>0 0 0 1.5707963267948966 0 0</pose>
      <geometry><cylinder><radius>0.03</radius><length>0.025</length></cylinder></geometry>
      <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
    </collision>
  </link>

  <!-- Front-right wheel -->
  <link name="up_right_Link">
    <pose>0.144 -0.081 0.03 0 0 0</pose>
    <inertial>
      <mass>0.05</mass>
      <inertia><ixx>0.0001</ixx><iyy>0.00005</iyy><izz>0.0001</izz></inertia>
    </inertial>
    <visual name="up_right_visual">
      <pose>0 0 0 1.5707963267948966 0 0</pose>
      <geometry><cylinder><radius>0.03</radius><length>0.025</length></cylinder></geometry>
      <material><ambient>0.1 0.1 0.1 1</ambient></material>
    </visual>
    <collision name="up_right_collision">
      <pose>0 0 0 1.5707963267948966 0 0</pose>
      <geometry><cylinder><radius>0.03</radius><length>0.025</length></cylinder></geometry>
      <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
    </collision>
  </link>

  <!-- ===== JOINTS ===== -->
  <!-- base_footprint → base_link (fixed, offset handled by pose) -->
  <joint name="base_footprint_joint" type="fixed">
    <parent>base_footprint</parent>
    <child>base_link</child>
  </joint>

  <!-- base_link → laser_link (fixed) -->
  <joint name="laser_joint" type="fixed">
    <parent>base_link</parent>
    <child>laser_link</child>
  </joint>

  <!-- REAR: base_link → wheel (rotation only) -->
  <joint name="down_left_joint" type="revolute">
    <parent>base_link</parent>
    <child>down_left_Link</child>
    <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
  </joint>

  <joint name="down_right_joint" type="revolute">
    <parent>base_link</parent>
    <child>down_right_Link</child>
    <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
  </joint>

  <!-- FRONT STEERING: base_link → steer_link (revolute around Z) -->
  <joint name="up_left_steer_joint" type="revolute">
    <parent>base_link</parent>
    <child>up_left_steer_link</child>
    <axis><xyz>0 0 1</xyz>
      <!-- DART requires an effort limit for a position-limited velocity
           controller. Without it Fortress may stop Ackermann odometry after
           the initial sample. -->
      <limit><lower>-1.0</lower><upper>1.0</upper><effort>1000000</effort></limit></axis>
  </joint>

  <joint name="up_right_steer_joint" type="revolute">
    <parent>base_link</parent>
    <child>up_right_steer_link</child>
    <axis><xyz>0 0 1</xyz>
      <limit><lower>-1.0</lower><upper>1.0</upper><effort>1000000</effort></limit></axis>
  </joint>

  <!-- FRONT WHEEL ROTATION: steer_link → wheel_link (revolute around Y) -->
  <joint name="up_left_joint" type="revolute">
    <parent>up_left_steer_link</parent>
    <child>up_left_Link</child>
    <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
  </joint>

  <joint name="up_right_joint" type="revolute">
    <parent>up_right_steer_link</parent>
    <child>up_right_Link</child>
    <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
  </joint>

  <!-- ===== PLUGINS ===== -->
  <plugin filename="ignition-gazebo-ackermann-steering-system"
          name="ignition::gazebo::systems::AckermannSteering">
    <!-- Drive both axles on each side. Supplying only the front pair leaves
         the rear tyres as passive, asymmetric contacts and makes the model
         pitch/slip under an otherwise valid Twist command. -->
    <left_joint>up_left_joint</left_joint>
    <left_joint>down_left_joint</left_joint>
    <right_joint>up_right_joint</right_joint>
    <right_joint>down_right_joint</right_joint>
    <left_steering_joint>up_left_steer_joint</left_steering_joint>
    <right_steering_joint>up_right_steer_joint</right_steering_joint>
    <!-- Fortress consumes steering_limit, not max_steering_angle. It converts
         that virtual angle to R=L/sin(limit). With the confirmed 0.144 m
         wheelbase, 0.714 rad admits the conservative 0.22 m rear-axle
         radius; the resulting inner wheel angle stays below +/-1.0 rad. -->
    <kingpin_width>0.162</kingpin_width>
    <steering_limit>0.714</steering_limit>
    <wheel_base>0.144</wheel_base>
    <wheel_separation>0.162</wheel_separation>
    <wheel_radius>0.03</wheel_radius>
    <!-- Do not configure min/max_velocity here. Fortress applies these values
         to both linear and angular Twist components; max_velocity=0.30 would
         silently clip the 0.30 / 0.22 = 1.364 rad/s Ackermann request and
         turn it into a ~0.50 m arc. Nav2's velocity_smoother remains the
         sole, explicitly tested owner of simulation speed and yaw limits. -->
    <!-- Fortress independently limits v and w at this layer. A low shared
         rate changes w / v during every turn-in, so a command which Nav2 has
         already ramped on one Ackermann radius starts as a much wider arc.
         Keep this transport limiter effectively transparent; the upstream
         velocity_smoother remains the only command-ramp owner. -->
    <min_acceleration>-100.0</min_acceleration>
    <max_acceleration>100.0</max_acceleration>
    <odom_publish_frequency>30</odom_publish_frequency>  <!-- sim: match real EKF rate, 50→30 saves ~3% CPU -->
    <topic>/cmd_vel</topic>
    <odom_topic>/odom</odom_topic>
  </plugin>

  <plugin filename="ignition-gazebo-joint-state-publisher-system"
          name="ignition::gazebo::systems::JointStatePublisher">
    <joint_name>down_left_joint</joint_name>
    <joint_name>down_right_joint</joint_name>
    <joint_name>up_left_steer_joint</joint_name>
    <joint_name>up_right_steer_joint</joint_name>
    <joint_name>up_left_joint</joint_name>
    <joint_name>up_right_joint</joint_name>
    <update_rate>20</update_rate>  <!-- sim: not consumed by nav, 50→20 -->
  </plugin>

  <!--
    Publish the model's physical world pose continuously.  SceneBroadcaster's
    /world/.../dynamic_pose/info is an event stream: when the initial event
    beats ROS DDS discovery and the car remains still, no later transform
    arrives for the ground-truth odometry relay.  This model-local publisher
    sends a Pose_V at 30 Hz even while stationary, so its Gazebo pose remains
    the sole source of odom_combined -> base_footprint.
  -->
  <plugin filename="ignition-gazebo-pose-publisher-system"
          name="ignition::gazebo::systems::PosePublisher">
    <publish_link_pose>false</publish_link_pose>
    <!-- Fortress requires nested-model publication to include this top-level
         model pose; keep both flags explicit rather than relying on defaults. -->
    <publish_nested_model_pose>true</publish_nested_model_pose>
    <publish_model_pose>true</publish_model_pose>
    <publish_visual_pose>false</publish_visual_pose>
    <publish_collision_pose>false</publish_collision_pose>
    <publish_sensor_pose>false</publish_sensor_pose>
    <use_pose_vector_msg>true</use_pose_vector_msg>
    <update_frequency>30</update_frequency>
  </plugin>

  <plugin filename="ignition-gazebo-user-commands-system"
          name="ignition::gazebo::systems::UserCommands"/>

  <plugin filename="ignition-gazebo-scene-broadcaster-system"
          name="ignition::gazebo::systems::SceneBroadcaster"/>
</model>
</sdf>
