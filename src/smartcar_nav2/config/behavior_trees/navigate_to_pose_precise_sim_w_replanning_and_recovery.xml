<!-- Gazebo P-to-A navigation: native Nav2 planning and RPP only. -->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="1" name="NavigatePreciseSimRecovery">
      <PipelineSequence name="NavigatePreciseSimWithReplanning">
        <RateController hz="1.0">
          <RecoveryNode number_of_retries="1" name="ComputePreciseSimPath">
            <ComputePathToPose
                goal="{goal}"
                path="{path}"
                planner_id="GridBased"/>
            <ClearEntireCostmap
                name="ClearGlobalCostmap-PreciseSimContext"
                service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPreciseSimPath">
          <FollowPath
              path="{path}"
              controller_id="FollowPath"
              goal_checker_id="precise_goal_checker"/>
          <ClearEntireCostmap
              name="ClearLocalCostmap-PreciseSimContext"
              service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>
      <Sequence name="ClearPreciseSimCostmapsRecovery">
        <ClearEntireCostmap
            name="ClearLocalCostmap-PreciseSimSubtree"
            service_name="local_costmap/clear_entirely_local_costmap"/>
        <ClearEntireCostmap
            name="ClearGlobalCostmap-PreciseSimSubtree"
            service_name="global_costmap/clear_entirely_global_costmap"/>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>
</root>
