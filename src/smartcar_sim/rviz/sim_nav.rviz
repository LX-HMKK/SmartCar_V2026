Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Displays:
    # ── Grid ──
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Reference Frame: odom_combined
      Plane Cell Count: 20
      Cell Size: 0.5
      Color: 125; 125; 125
      Enabled: true

    # ── Prior-map keepout mask ──
    - Class: rviz_default_plugins/Map
      Name: KeepoutMask
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /keepout_filter_mask
      Color Scheme: costmap
      Alpha: 0.7
      Draw Behind: false
      Enabled: true

    # ── Robot Model ──
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /robot_description
      Visual Enabled: true
      Enabled: true

    # ── TF ──
    - Class: rviz_default_plugins/TF
      Name: TF
      Frame Timeout: 15
      All Enabled: true
      Frames:
        base_footprint:
          Value: true
        base_link:
          Value: true
        laser_link:
          Value: true
      Enabled: true

    # ── LaserScan ──
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Topic:
        # Do not queue several simulated frames while RViz is rendering.
        # The display is diagnostic, so the newest sample is more useful than
        # a history that visually trails the odometry.
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        Value: /scan
      Queue Size: 1
      Size (m): 0.02
      Style: Points
      Color: 255; 0; 0
      Decay Time: 0.0
      Enabled: true

    # ── Local Costmap ──
    - Class: rviz_default_plugins/Map
      Name: LocalCostmap
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /local_costmap/costmap
      Color Scheme: costmap
      Alpha: 1.0
      Draw Behind: true
      Enabled: true

    # ── Global Costmap ──
    - Class: rviz_default_plugins/Map
      Name: GlobalCostmap
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /global_costmap/costmap
      Color Scheme: costmap
      Draw Behind: true
      Enabled: true

    # `/plan` contains every free-heading candidate, including candidates
    # rejected before FollowPath. Keep it available for diagnosis, but do not
    # render it as the vehicle's intended route.
    - Class: rviz_default_plugins/Path
      Name: Planner Candidate Path (/plan)
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /plan
      Color: 160; 160; 160
      Line Style: Solid
      Line Width: 0.04
      Enabled: false

    # This project topic is published only after controller_server accepts a
    # raw FollowPath goal. Unlike Humble RPP's clipped tracking window, it is
    # the full global route actually handed to the active controller.
    - Class: rviz_default_plugins/Path
      Name: Accepted Global Path (/smartcar/accepted_global_plan)
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /smartcar/accepted_global_plan
      Color: 0; 255; 0
      Line Style: Solid
      Line Width: 0.08
      Enabled: true

    # RPP's transformed window is the current tracking subset, unlike the
    # planner's global candidate topic. Humble does not publish /local_plan
    # for this controller plugin.
    - Class: rviz_default_plugins/Path
      Name: Controller Tracking Window (/transformed_global_plan)
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /transformed_global_plan
      Color: 255; 200; 0
      Line Width: 0.06
      Enabled: true

    # ── Odometry ──
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        Value: /odom_combined
      Position Tolerance: 0.3
      Angle Tolerance: 0.1
      Keep: 30
      Shape:
        Alpha: 0.6
        Axes Length: 0.05
        Axes Radius: 0.004
        Color: 100; 200; 255
        Head Length: 0.015
        Head Radius: 0.01
        Shaft Length: 0.025
        Shaft Radius: 0.004
        Value: Arrow
      Enabled: true

    # ── Ordered waypoint constraints; not a Nav2-generated path ──
    - Class: rviz_default_plugins/MarkerArray
      Name: Waypoint Reference Constraints (not a Nav2 path)
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /smartcar/waypoints/markers
      Enabled: true

    # Complete official field geometry, display-only (not a Nav2 static map).
    - Class: rviz_default_plugins/MarkerArray
      Name: Official Field Reference
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /smartcar/field_reference/markers
      Enabled: true

  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom_combined
    Frame Limit: 50
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
    - Class: rviz_default_plugins/SetGoal

  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: odom_combined
      Yaw: 0.0
      Scale: 80.0
      X: 2.0
      Y: 2.25
    Saved:
      - Class: rviz_default_plugins/TopDownOrtho
        Name: Top View
        Target Frame: odom_combined
        Yaw: 0.0
        Scale: 80.0
        X: 2.0
        Y: 2.25

Window Geometry:
  Height: 900
  Width: 1400
