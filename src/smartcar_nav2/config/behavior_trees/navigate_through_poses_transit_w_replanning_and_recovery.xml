<!-- Up to three native BackUp recoveries replan only remaining constraints. -->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="3" name="ReplanRemainingGoalsAfterNativeBackUp">
      <Sequence name="PlanThenTrackTransitThroughPath">
        <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"/>
        <PipelineSequence name="TrackTransitThroughPathAndPersistPassedConstraints">
          <RemovePassedGoals input_goals="{goals}" output_goals="{goals}" radius="0.40" global_frame="odom_combined" robot_base_frame="base_footprint"/>
          <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="transit_goal_checker"/>
        </PipelineSequence>
      </Sequence>
      <Sequence name="NativeBackUpAndPruneRemainingConstraints">
        <BackUp backup_dist="0.20" backup_speed="0.15" time_allowance="4.0"/>
        <RemovePassedGoals input_goals="{goals}" output_goals="{goals}" radius="0.40" global_frame="odom_combined" robot_base_frame="base_footprint"/>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>
</root>
