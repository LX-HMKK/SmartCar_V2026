<!--
  Plan a segment once, then track it. While tracking, retain only the remaining
  ordered planning constraints. On each of at most six failures, run the
  native bounded BackUp, prune again, and let the recovery node replan only
  those remaining goals.
  RemovePassedGoals never completes a mission waypoint; FollowPath still owns
  endpoint arrival.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="ReplanRemainingGoalsAfterNativeBackUp">
      <Sequence name="PlanThenTrackThroughPath">
        <ComputePathThroughPoses goals="{goals}" path="{raw_path}" planner_id="GridBased"/>
        <RemoveDuplicatePathPoints input_path="{raw_path}" output_path="{deduplicated_path}"/>
        <SmoothPath unsmoothed_path="{deduplicated_path}" smoothed_path="{path}" smoother_id="constrained_smoother" max_smoothing_duration="0.20" check_for_collisions="true"/>
        <PipelineSequence name="TrackThroughPathAndPersistPassedConstraints">
          <RemovePassedGoals input_goals="{goals}" output_goals="{goals}" radius="0.40" global_frame="odom_combined" robot_base_frame="base_footprint"/>
          <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="goal_checker"/>
        </PipelineSequence>
      </Sequence>
      <Sequence name="NativeBackUpAndPruneRemainingConstraints">
        <BackUp backup_dist="0.20" backup_speed="0.25" time_allowance="4.0"/>
        <RemovePassedGoals input_goals="{goals}" output_goals="{goals}" radius="0.40" global_frame="odom_combined" robot_base_frame="base_footprint"/>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>
</root>
