<?xml version="1.0" encoding="UTF-8"?>
<!-- FastDDS 本地回环配置
     UDP 仅绑定 127.0.0.1，配合 WSL2 firewall=false 绕过 DDS discovery 阻断。
     保留 SHM 传输（本机通信更快），同时限制 UDP 在本地回环。
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <participant profile_name="loopback_only" is_default_profile="true">
    <rtps>
      <builtin>
        <!-- 仅通过回环接口发现 -->
        <metatrafficUnicastLocatorList>
          <locator>
            <udpv4><address>127.0.0.1</address></udpv4>
          </locator>
        </metatrafficUnicastLocatorList>
        <initialPeersList>
          <locator>
            <udpv4><address>127.0.0.1</address></udpv4>
          </locator>
        </initialPeersList>
      </builtin>
    </rtps>
  </participant>
</profiles>
