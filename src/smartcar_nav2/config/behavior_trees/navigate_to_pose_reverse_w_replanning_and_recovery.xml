<!-- Reverse-only Ackermann tree: no spin, backup, wait, or direction changes. -->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="NavigateReverseWithSingleRetreat">
      <LatchSuccess name="InitializeReverseRetreatGate">
        <SetBlackboard value="false" output_key="reverse_retreat_used"/>
      </LatchSuccess>
    <RecoveryNode number_of_retries="6" name="NavigateReverseRecovery">
      <Sequence name="NavigateReverseWithFailureReplanning">
        <LatchSuccess name="LatchValidatedReverseFreeHeadingPath">
          <RecoveryNode number_of_retries="1" name="ComputeReversePathAfterRetreat">
            <RecoveryNode number_of_retries="1" name="ComputeValidatedReverseFreeHeadingPath">
            <Sequence>
              <ComputeReverseFreeHeadingPathToPose
                goal="{goal}"
                path="{path}"
                recovery_eligible="{reverse_planner_unreachable}"
                costmap_stamp_ns="{reverse_planner_costmap_stamp_ns}"
                local_costmap_stamp_ns="{reverse_planner_local_costmap_stamp_ns}"
                planner_id="GridBased"
                heading_samples="12"
                candidate_timeout_ms="3500"
                max_start_drift_m="0.10"
                footprint_half_length_m="0.2491"
                footprint_half_width_m="0.095"
                footprint_sweep_step_m="0.025"
                footprint_lethal_cost="254"
                curvature_tolerance="0.20"
                maximum_direction_error="0.35"
                start_position_tolerance="0.10"
                start_yaw_tolerance="0.15"
                goal_position_tolerance="0.12"
                goal_yaw_tolerance="0.15"
                minimum_segment_length="0.0001"/>
              <IsPathValid path="{path}" server_timeout="100"/>
            </Sequence>
            <Sequence name="ClearReverseCostmapsBeforeRetreat">
              <ClearEntireCostmap
                name="ClearLocalCostmap-ReverseContext"
                service_name="local_costmap/clear_entirely_local_costmap"/>
              <ClearEntireCostmap
                name="ClearGlobalCostmap-ReverseContext"
                service_name="global_costmap/clear_entirely_global_costmap"/>
            </Sequence>
            </RecoveryNode>
            <Sequence name="ReverseRetreatBeforeReplan">
            <AckermannReverseRetreat
              allow_retreat="{reverse_planner_unreachable}"
              retreat_used="{reverse_retreat_used}"
              path="{reverse_retreat_path}"
              controller_id="ReverseRecovery"
              goal_checker_id="recovery_goal_checker"
              retreat_distance_m="0.15"
                costmap_max_age_ms="1500"
                perception_wait_timeout_ms="2600"
                follow_path_goal_timeout_ms="1000"
                follow_path_result_timeout_ms="12000"
                scan_costmap_fusion_lag_ms="1250"
                costmap_min_stamp_ns="{reverse_planner_costmap_stamp_ns}"
                local_costmap_min_stamp_ns="{reverse_planner_local_costmap_stamp_ns}"
                footprint_half_length_m="0.2491"
              footprint_half_width_m="0.095"
              footprint_sweep_step_m="0.025"
              footprint_lethal_cost="253"
                scan_min_obstacle_range_m="0.25"
                scan_max_obstacle_range_m="2.50"
                scan_costmap_match_radius_m="0.12"
                retreat_odom_max_age_ms="500"
                retreat_odom_max_step_m="0.05"
                retreat_odom_max_travel_m="0.19"
                retreat_odom_max_displacement_m="0.19"/>
            <ClearEntireCostmap
              name="ClearLocalCostmap-AfterReverseRetreat"
              service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap
              name="ClearGlobalCostmap-AfterReverseRetreat"
              service_name="global_costmap/clear_entirely_global_costmap"/>
            </Sequence>
          </RecoveryNode>
        </LatchSuccess>
        <RecoveryNode number_of_retries="1" name="FollowValidatedReversePath">
          <RecordFollowPath
            path="{path}"
            controller_id="ReverseHandoff"
            goal_checker_id="reverse_goal_checker"/>
          <ClearEntireCostmap
            name="ClearLocalCostmap-ReverseContext"
            service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </Sequence>
      <Sequence name="ClearReverseCostmapsRecovery">
        <ClearEntireCostmap
          name="ClearLocalCostmap-ReverseSubtree"
          service_name="local_costmap/clear_entirely_local_costmap"/>
        <ClearEntireCostmap
          name="ClearGlobalCostmap-ReverseSubtree"
          service_name="global_costmap/clear_entirely_global_costmap"/>
      </Sequence>
    </RecoveryNode>
    </Sequence>
  </BehaviorTree>
</root>
