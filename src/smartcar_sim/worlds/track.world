<?xml version="1.0" ?>
<sdf version="1.8">
<world name="smartcar_track">
  <!-- Physics: real-time factor 1.0, 0.001 step for stable Ackermann -->
  <physics name="1ms" type="ignored">
    <max_step_size>0.001</max_step_size>
    <real_time_factor>1.0</real_time_factor>
  </physics>

  <!-- GUI plugin -->
  <plugin
    filename="ignition-gazebo-gui-system"
    name="ignition::gazebo::systems::Gui">
  </plugin>

  <!-- User commands -->
  <plugin
    filename="ignition-gazebo-user-commands-system"
    name="ignition::gazebo::systems::UserCommands">
  </plugin>

  <!-- Physics -->
  <plugin
    filename="ignition-gazebo-physics-system"
    name="ignition::gazebo::systems::Physics">
  </plugin>

  <!-- Sensors (LiDAR + IMU) -->
  <plugin
    filename="ignition-gazebo-sensors-system"
    name="ignition::gazebo::systems::Sensors">
    <render_engine>ogre2</render_engine>
  </plugin>

  <!-- Scene broadcaster -->
  <plugin
    filename="ignition-gazebo-scene-broadcaster-system"
    name="ignition::gazebo::systems::SceneBroadcaster">
  </plugin>

  <!-- ===== LIGHTING ===== -->
  <light type="directional" name="sun">
    <pose>5 5 10 0 0 0</pose>
    <diffuse>1 1 1 1</diffuse>
    <specular>0.5 0.5 0.5 1</specular>
    <attenuation>
      <range>50</range>
    </attenuation>
    <direction>-0.5 -0.5 -1.0</direction>
    <cast_shadows>true</cast_shadows>
  </light>

  <!-- ===== GROUND PLANE ===== -->
  <model name="ground_plane">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>20 20</size>
          </plane>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.8</mu><mu2>0.8</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>20 20</size>
          </plane>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.4 0.4 0.4 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <!-- ===== TRACK MARKERS =====
    P-zone: (0, 0) → start/finish area
    QR zone: (3.13, 0.98) → task observation point
    Corridor: (2.09, 1.83) → (1.83, 2.54) → reverse section
    C-zone: (0.39, 2.68) → (0.83, 3.9) → (3.18, 3.9) → (3.18, 2.75)
    Return corridor: (2.13, 2.52) → (1.88, 1.83)
  -->

  <!-- P-zone marker box -->
  <model name="p_zone">
    <static>true</static>
    <pose>0 0 0.001 0 0 0</pose>
    <link name="link">
      <visual name="visual">
        <geometry>
          <box><size>0.5 0.5 0.005</size></box>
        </geometry>
        <material>
          <ambient>0 1 0 1</ambient>
          <diffuse>0 1 0 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <!-- QR zone marker -->
  <model name="qr_zone">
    <static>true</static>
    <pose>3.127 0.977 0.001 0 0 0.5236</pose>
    <link name="link">
      <visual name="visual">
        <geometry>
          <box><size>0.3 0.3 0.005</size></box>
        </geometry>
        <material>
          <ambient>1 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <!-- Corridor walls (thin barriers) -->
  <model name="corridor_wall_left">
    <static>true</static>
    <pose>2.45 1.5 0.15 0 0 0</pose>
    <link name="link">
      <visual name="visual">
        <geometry>
          <box><size>1.0 0.05 0.3</size></box>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.2 0.5</ambient>
          <diffuse>0.8 0.8 0.2 0.5</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <box><size>1.0 0.05 0.3</size></box>
        </geometry>
      </collision>
    </link>
  </model>

  <model name="corridor_wall_right">
    <static>true</static>
    <pose>2.45 2.2 0.15 0 0 0</pose>
    <link name="link">
      <visual name="visual">
        <geometry>
          <box><size>1.0 0.05 0.3</size></box>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.2 0.5</ambient>
          <diffuse>0.8 0.8 0.2 0.5</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <box><size>1.0 0.05 0.3</size></box>
        </geometry>
      </collision>
    </link>
  </model>

  <!-- C-zone return wall -->
  <model name="czone_wall">
    <static>true</static>
    <pose>2.0 3.95 0.15 0 0 0</pose>
    <link name="link">
      <visual name="visual">
        <geometry>
          <box><size>3.0 0.05 0.3</size></box>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.2 0.5</ambient>
          <diffuse>0.8 0.8 0.2 0.5</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <box><size>3.0 0.05 0.3</size></box>
        </geometry>
      </collision>
    </link>
  </model>

  <!-- ===== ZONE-A CONE OBSTACLES (0.3×0.3m cubes, randomly placeable) =====
    A 区随机锥桶群。调参时修改 <pose> 调整位置，或注释掉部分锥桶测试不同密度。
  -->
  <model name="cone_a1"><static>true</static><pose>0.8 0.4 0.15 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>0.3 0.3 0.3</size></box></geometry>
      <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>0.3 0.3 0.3</size></box></geometry></collision>
    </link></model>
  <model name="cone_a2"><static>true</static><pose>1.5 0.3 0.15 0 0 0</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>0.3 0.3 0.3</size></box></geometry>
      <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>0.3 0.3 0.3</size></box></geometry></collision>
    </link></model>
  <model name="cone_a3"><static>true</static><pose>2.2 0.5 0.15 0 0 0.3</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>0.3 0.3 0.3</size></box></geometry>
      <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>0.3 0.3 0.3</size></box></geometry></collision>
    </link></model>
  <model name="cone_a4"><static>true</static><pose>1.0 0.8 0.15 0 0 0.5</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>0.3 0.3 0.3</size></box></geometry>
      <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>0.3 0.3 0.3</size></box></geometry></collision>
    </link></model>
  <model name="cone_a5"><static>true</static><pose>1.8 0.9 0.15 0 0 -0.3</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>0.3 0.3 0.3</size></box></geometry>
      <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>0.3 0.3 0.3</size></box></geometry></collision>
    </link></model>
  <model name="cone_a6"><static>true</static><pose>2.8 0.7 0.15 0 0 0.7</pose>
    <link name="link">
      <visual name="v"><geometry><box><size>0.3 0.3 0.3</size></box></geometry>
      <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>0.3 0.3 0.3</size></box></geometry></collision>
    </link></model>

  <!-- ===== ROBOT ===== -->
  <include>
    <pose>0 0 0.03 0 0 0</pose>
    <uri>model://origincar</uri>
  </include>

  <!-- ===== WAYPOINT VISUALIZATION MARKERS ===== -->
  <model name="wp_corner_1"><static>true</static><pose>0.387 2.682 0.01 0 0 1.0472</pose>
    <link name="link"><visual name="v"><geometry><cylinder><radius>0.05</radius><length>0.01</length></cylinder></geometry><material><ambient>0 0 1 1</ambient></material></visual></link></model>

  <model name="wp_corner_2"><static>true</static><pose>0.825 3.9 0.01 0 0 0</pose>
    <link name="link"><visual name="v"><geometry><cylinder><radius>0.05</radius><length>0.01</length></cylinder></geometry><material><ambient>0 0 1 1</ambient></material></visual></link></model>

  <model name="wp_corner_3"><static>true</static><pose>3.175 3.9 0.01 0 0 -0.5236</pose>
    <link name="link"><visual name="v"><geometry><cylinder><radius>0.05</radius><length>0.01</length></cylinder></geometry><material><ambient>0 0 1 1</ambient></material></visual></link></model>

  <model name="wp_corner_4"><static>true</static><pose>3.175 2.75 0.01 0 0 3.1416</pose>
    <link name="link"><visual name="v"><geometry><cylinder><radius>0.05</radius><length>0.01</length></cylinder></geometry><material><ambient>0 0 1 1</ambient></material></visual></link></model>

</world>
</sdf>
