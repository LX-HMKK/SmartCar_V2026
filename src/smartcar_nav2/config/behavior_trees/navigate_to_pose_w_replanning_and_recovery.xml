<!-- Ackermann-safe tree: no backup, no wait, no spin.  Clear costmaps + replan only. -->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <OdomDistanceBudget
        goal="{goal}"
        odom_topic="/odom_combined"
        odom_frame="odom_combined"
        robot_base_frame="base_footprint"
        max_distance_ratio="2.00"
        distance_slack_m="0.80"
        max_odom_step_m="0.50"
        odom_timeout_sec="0.50"
        initial_odom_wait_sec="1.00">
      <RecoveryNode number_of_retries="6" name="NavigateRecovery">
        <PipelineSequence name="NavigateWithReplanning">
          <LatchSuccess name="LatchFreeHeadingPathToPose">
            <RateController hz="0.5">
              <RecoveryNode number_of_retries="1" name="ComputeFreeHeadingPathToPose">
                <!-- The direct VLM->P semantic return has a field-required
                     obstacle arc of about 1.717x its chord. Keep this narrow
                     forward-only allowance below the independent 2.00x
                     executed-travel contract; reverse trees remain at 1.60x. -->
                <ComputeFreeHeadingPathToPose
                    goal="{goal}"
                    path="{path}"
                    planner_id="GridBased"
                    heading_samples="12"
                    candidate_timeout_ms="3500"
                    max_initial_path_length_ratio="1.60"
                    max_edge_path_length_ratio="1.75"
                    max_start_drift_m="0.10"
                    footprint_half_length_m="0.30"
                    footprint_half_width_m="0.16"
                    footprint_sweep_step_m="0.025"
                    footprint_lethal_cost="253"
                    local_tracking_cross_track_error_m="0.10"
                    local_tracking_horizon_m="0.50"
                    local_tracking_lethal_cost="254"/>
                <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
              </RecoveryNode>
            </RateController>
          </LatchSuccess>
          <RecoveryNode number_of_retries="1" name="FollowPath">
            <RecordFollowPath path="{path}" controller_id="ForwardAvoidance" goal_checker_id="goal_checker"/>
            <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
          </RecoveryNode>
        </PipelineSequence>
        <Sequence name="ClearCostmapsRecovery">
          <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
          <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
        </Sequence>
      </RecoveryNode>
    </OdomDistanceBudget>
  </BehaviorTree>
</root>
