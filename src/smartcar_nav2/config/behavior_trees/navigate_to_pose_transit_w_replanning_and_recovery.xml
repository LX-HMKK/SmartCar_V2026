<!-- Forward position-only transit tree. The free-heading planner chooses a
     collision-free terminal tangent; do not force an authored yaw at a via. -->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
      <RecoveryNode number_of_retries="6" name="NavigateTransitRecovery">
        <PipelineSequence name="NavigateTransitWithReplanning">
          <LatchSuccess name="LatchFreeHeadingTransitPathToPose">
            <RateController hz="0.5">
              <RecoveryNode number_of_retries="1" name="ComputeFreeHeadingTransitPathToPose">
                <ComputeFreeHeadingPathToPose
                    goal="{goal}"
                    path="{path}"
                    planner_id="GridBased"
                    heading_samples="12"
                    candidate_timeout_ms="3500"
                    max_start_drift_m="0.10"
                    footprint_half_length_m="0.2491"
                    footprint_half_width_m="0.095"
                    footprint_sweep_step_m="0.025"
                    footprint_lethal_cost="253"
                    local_tracking_cross_track_error_m="0.10"
                    local_tracking_horizon_m="0.50"
                    local_tracking_lethal_cost="254"/>
                <ClearEntireCostmap name="ClearGlobalCostmap-TransitContext" service_name="global_costmap/clear_entirely_global_costmap"/>
              </RecoveryNode>
            </RateController>
          </LatchSuccess>
          <RecoveryNode number_of_retries="1" name="FollowTransitPath">
            <RecordFollowPath path="{path}" controller_id="ForwardAvoidance" goal_checker_id="transit_goal_checker"/>
            <ClearEntireCostmap name="ClearLocalCostmap-TransitContext" service_name="local_costmap/clear_entirely_local_costmap"/>
          </RecoveryNode>
        </PipelineSequence>
        <Sequence name="ClearTransitCostmapsRecovery">
          <ClearEntireCostmap name="ClearLocalCostmap-TransitSubtree" service_name="local_costmap/clear_entirely_local_costmap"/>
          <ClearEntireCostmap name="ClearGlobalCostmap-TransitSubtree" service_name="global_costmap/clear_entirely_global_costmap"/>
        </Sequence>
      </RecoveryNode>
  </BehaviorTree>
</root>
