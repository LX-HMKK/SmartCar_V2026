<!-- Native Nav2 planning and tracking through points to P. -->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="5" name="NavigateReturnRecovery">
      <PipelineSequence name="NavigateReturnWithReplanning">
        <RecoveryNode number_of_retries="1" name="ComputePathThroughPoses">
          <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"/>
          <ClearEntireCostmap name="ClearGlobalCostmap-ReturnContext" service_name="global_costmap/clear_entirely_global_costmap"/>
        </RecoveryNode>
        <RecoveryNode number_of_retries="1" name="FollowReturnPath">
          <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="return_goal_checker"/>
          <ClearEntireCostmap name="ClearLocalCostmap-ReturnContext" service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>
      <Sequence name="ClearReturnCostmapsRecovery">
        <ClearEntireCostmap name="ClearLocalCostmap-ReturnSubtree" service_name="local_costmap/clear_entirely_local_costmap"/>
        <ClearEntireCostmap name="ClearGlobalCostmap-ReturnSubtree" service_name="global_costmap/clear_entirely_global_costmap"/>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>
</root>
